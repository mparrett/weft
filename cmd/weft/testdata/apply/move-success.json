{
  "name": "move-success",
  "about": "Move a holder's scoped claim from A to B in one batch.",
  "setup": {
    "ops": [
      {
        "op": "add",
        "as": "$A",
        "title": "ws a",
        "kind": "workstream",
        "ns": "workstreams",
        "refs": [
          "ws:a"
        ]
      },
      {
        "op": "add",
        "as": "$B",
        "title": "ws b",
        "kind": "workstream",
        "ns": "workstreams",
        "refs": [
          "ws:b"
        ]
      },
      {
        "op": "ref.add",
        "node": "$A",
        "ref": "session:S1",
        "source": "observed"
      },
      {
        "op": "claim",
        "node": "$A",
        "holder": "agent:S1",
        "source": "observed"
      }
    ]
  },
  "args": [],
  "request": {
    "expect": [
      {
        "holder": "agent:S1",
        "live_on": [
          "<A>"
        ],
        "ns": "workstreams",
        "kind": "workstream"
      },
      {
        "node": "<B>",
        "state": "open"
      }
    ],
    "ops": [
      {
        "op": "release",
        "node": "<A>",
        "holder": "agent:S1"
      },
      {
        "op": "ref.add",
        "node": "<B>",
        "ref": "session:S1",
        "source": "observed"
      },
      {
        "op": "claim",
        "node": "<B>",
        "holder": "agent:S1",
        "source": "observed"
      }
    ]
  },
  "exit": 0,
  "reply": {
    "committed": true,
    "key": "<key>",
    "rev": "<rev>",
    "results": [
      {
        "i": 0,
        "op": "release",
        "changed": true,
        "node": "<A>",
        "claims": [
          "<setup.3.claim>"
        ]
      },
      {
        "i": 1,
        "op": "ref.add",
        "changed": true,
        "node": "<B>"
      },
      {
        "i": 2,
        "op": "claim",
        "changed": true,
        "node": "<B>",
        "claim": "<id>"
      }
    ]
  }
}
